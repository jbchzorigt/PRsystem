# Local development environment — RUNTIME ONLY.
#
# Copy to .env and adjust. .env is git-ignored.
#
# This file deliberately contains no migration credential. `MIGRATION_DATABASE_URL`
# names a principal that can apply DDL, and both the API and the worker refuse to
# start if they are handed it — so a runtime environment copied from this file
# cannot carry it by accident. The migration step has its own template:
# `.env.migration.example`.
#
# Host ports are deliberately in a PRsystem-only range so the stack cannot collide
# with other projects already bound to 5432/6379/9000/3000 on a developer machine.
# The compose project is named `prsystem`; it owns no container outside that project.
#
# This file contains LOCAL DEVELOPMENT DEFAULTS ONLY. It must never contain a real
# credential, token or key (CLAUDE.md §8). Production values come from a secret
# manager and are injected at runtime.

# --- runtime -------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# --- api ------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=53000

# --- postgres (docker compose) --------------------------------------------------
POSTGRES_USER=prsystem
POSTGRES_PASSWORD=prsystem_local_dev
POSTGRES_DB=prsystem
POSTGRES_PORT=55442
# Runtime connection: a restricted login that is a member of prsystem_api or
# prsystem_worker only. Never a superuser, never the migration login.
DATABASE_URL=postgresql://prsystem_api_login:prsystem_local_dev@127.0.0.1:55442/prsystem
# D-09. The job-scheduler capability and its credential, for the API only.
#
# Issuing a privileged maintenance job and executing one are different powers.
# The worker must never receive either value: a worker that could issue its own
# authorisation is the arrangement D-09 exists to prevent, and the worker
# refuses to start if it finds them.
#
# The capability and the credential travel together, and the API validates both
# combinations at startup:
#   SCHEDULER_ENABLED=true  requires SCHEDULER_DATABASE_URL, in every environment;
#   SCHEDULER_ENABLED=false forbids it, because a scheduler credential in a
#                           deployment that will never use it is a live
#                           credential nobody is accounting for.
# Unset defaults to enabled for APP_ENV=production and disabled everywhere else.
SCHEDULER_ENABLED=true
SCHEDULER_DATABASE_URL=postgresql://prsystem_job_scheduler_login:CHANGE_ME@127.0.0.1:55442/prsystem

# --- redis (docker compose) -----------------------------------------------------
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379
# Optional BullMQ key prefix shared by the API's provisioning signal and the worker's
# consumers. Leave unset for one deployment per Redis.
# QUEUE_PREFIX=prsystem

# --- external adapters (Phase 20) -----------------------------------------------
# One variable per adapter slot: `simulator`, `disabled`, or a production adapter
# by name. Absent, a slot is the simulator for APP_ENV=local|ci and `disabled`
# for staging and production. The rules are enforced at startup and fail closed:
#   - `simulator` is refused outside local, ci and test;
#   - a production adapter is refused in staging and production until the gate
#     that governs it is CLEARED in docs/implementation/external-integration-gates.md
#     and in packages/ports/src/gates.ts (every gate is BLOCKED at Phase 20);
#   - an adapter nobody has written cannot be named at all.
# Below production a written adapter may run against a local stand-in, which is
# how the S3 adapter is tested here — against the compose stack's MinIO.
# ADAPTER_PAYMENT_QPAY=simulator
# ADAPTER_PAYMENT_KHAAN=simulator
# ADAPTER_EBARIMT=simulator
# ADAPTER_XYP=simulator
# ADAPTER_EMONGOLIA=simulator
# ADAPTER_SMS=simulator
# ADAPTER_GEO=simulator
# ADAPTER_PAYOUT=simulator
# ADAPTER_EMAIL=simulator
# ADAPTER_OTP=simulator
ADAPTER_STORAGE=s3

# Provider callback source allowlists, comma-separated CIDR ranges per provider.
# Unset below production means "no allowlist, allow"; unset in staging or
# production means every callback from that provider is refused. The ranges are
# a term of the provider's contract (EXT-03, EXT-04) and none is approved.
# CALLBACK_ALLOWLIST_QPAY=203.0.113.0/24
# CALLBACK_ALLOWLIST_KHAAN=198.51.100.0/24

# --- object storage (minio, docker compose) -------------------------------------
# Read only when ADAPTER_STORAGE=s3; the secret is refused when it is not, so a
# storage credential never sits in a deployment whose storage adapter is off.
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:59000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=prsystem-local
OBJECT_STORAGE_ACCESS_KEY_ID=prsystem_local
OBJECT_STORAGE_SECRET_ACCESS_KEY=prsystem_local_dev

# --- email (mailpit, docker compose) --------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
MAILPIT_UI_PORT=58025

# --- key management -------------------------------------------------------------
# `none` fails closed. `local` selects the deterministic simulator and is refused
# outside local/ci/test. INT-KMS-01 gates the production adapter.
KMS_ADAPTER=local
KMS_SEED=local-development-seed-not-a-secret

# --- telemetry ------------------------------------------------------------------
OTEL_SERVICE_NAME=prsystem
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
