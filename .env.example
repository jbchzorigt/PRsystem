# Local development environment.
#
# Copy to .env and adjust. .env is git-ignored.
#
# Host ports are deliberately in a PRsystem-only range so the stack cannot collide
# with other projects already bound to 5432/6379/9000/3000 on a developer machine.
# The compose project is named `prsystem`; it owns no container outside that project.
#
# This file contains LOCAL DEVELOPMENT DEFAULTS ONLY. It must never contain a real
# credential, token or key (CLAUDE.md §8). Production values come from a secret
# manager and are injected at runtime.

# --- runtime -------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# --- api ------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=53000

# --- postgres (docker compose) --------------------------------------------------
POSTGRES_USER=prsystem
POSTGRES_PASSWORD=prsystem_local_dev
POSTGRES_DB=prsystem
POSTGRES_PORT=55442
# Runtime connection: a restricted login that is a member of prsystem_api or
# prsystem_worker only. Never a superuser, never the migration login.
DATABASE_URL=postgresql://prsystem_api_login:prsystem_local_dev@127.0.0.1:55442/prsystem
# Migration connection: the prsystem_migrate_login principal. Held by the
# migration step alone; the API and worker reject it at startup.
MIGRATION_DATABASE_URL=postgresql://prsystem_migrate_login:prsystem_local_dev@127.0.0.1:55442/prsystem

# D-09. The job-scheduler capability and its credential, for the API only.
#
# Issuing a privileged maintenance job and executing one are different powers.
# The worker must never receive either value: a worker that could issue its own
# authorisation is the arrangement D-09 exists to prevent, and the worker
# refuses to start if it finds them.
#
# The capability and the credential travel together, and the API validates both
# combinations at startup:
#   SCHEDULER_ENABLED=true  requires SCHEDULER_DATABASE_URL, in every environment;
#   SCHEDULER_ENABLED=false forbids it, because a scheduler credential in a
#                           deployment that will never use it is a live
#                           credential nobody is accounting for.
# Unset defaults to enabled for APP_ENV=production and disabled everywhere else.
SCHEDULER_ENABLED=true
SCHEDULER_DATABASE_URL=postgresql://prsystem_job_scheduler_login:CHANGE_ME@127.0.0.1:55442/prsystem

# --- redis (docker compose) -----------------------------------------------------
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379

# --- object storage (minio, docker compose) -------------------------------------
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:59000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=prsystem-local
OBJECT_STORAGE_ACCESS_KEY_ID=prsystem_local
OBJECT_STORAGE_SECRET_ACCESS_KEY=prsystem_local_dev

# --- email (mailpit, docker compose) --------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
MAILPIT_UI_PORT=58025

# --- key management -------------------------------------------------------------
# `none` fails closed. `local` selects the deterministic simulator and is refused
# outside local/ci/test. INT-KMS-01 gates the production adapter.
KMS_ADAPTER=local
KMS_SEED=local-development-seed-not-a-secret

# --- telemetry ------------------------------------------------------------------
OTEL_SERVICE_NAME=prsystem
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
