{
  "name": "@prsystem/worker",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --exclude 'src/startup.test.ts' --exclude 'src/onboarding.e2e.test.ts'",
    "test:integration": "vitest run src/onboarding.e2e.test.ts",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test:security": "vitest run src/startup.test.ts"
  },
  "dependencies": {
    "@prsystem/api": "workspace:*",
    "@prsystem/config": "workspace:*",
    "@prsystem/contracts": "workspace:*",
    "@prsystem/db": "workspace:*",
    "@prsystem/outbox": "workspace:*",
    "@prsystem/ports": "workspace:*",
    "@prsystem/telemetry": "workspace:*",
    "bullmq": "5.81.3",
    "ioredis": "5.11.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@nestjs/platform-fastify": "11.2.3",
    "@prsystem/testing": "workspace:*",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
