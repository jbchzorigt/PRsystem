{
  "name": "@prsystem/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    },
    "./onboarding-worker": {
      "types": "./dist/onboarding-worker.d.ts",
      "default": "./dist/onboarding-worker.js"
    }
  },
  "typesVersions": {
    "*": {
      "bootstrap": [
        "dist/bootstrap.d.ts"
      ],
      "onboarding-worker": [
        "dist/onboarding-worker.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --exclude 'src/security/**' --exclude 'src/health/health.http.test.ts' --exclude 'src/modules/iam/iam.integration.test.ts' --exclude 'src/modules/iam/iam.repair.test.ts' --exclude 'src/modules/iam/iam.remediation2.test.ts' --exclude 'src/modules/iam/iam.remediation3.test.ts' --exclude 'src/modules/iam/iam.remediation4.test.ts' --exclude 'src/modules/iam/iam.concurrency.test.ts' --exclude 'src/modules/onboarding/onboarding.integration.test.ts' --exclude 'src/modules/onboarding/subscription.integration.test.ts' --exclude 'src/modules/onboarding/onboarding.concurrency.test.ts' --exclude 'src/modules/onboarding/onboarding.security.test.ts' --exclude 'src/modules/onboarding/onboarding.remediation1.test.ts' --exclude 'src/modules/onboarding/subscription.remediation1.test.ts' --exclude 'src/modules/onboarding/onboarding.authorization.http.test.ts' --exclude 'src/modules/onboarding/contracts/bullmq-provisioning-signal.test.ts' --exclude 'src/modules/onboarding/onboarding.remediation2.test.ts' --exclude 'src/modules/catalog/catalog.integration.test.ts' --exclude 'src/modules/catalog/catalog.dependency.test.ts' --exclude 'src/modules/catalog/catalog.authorization.http.test.ts' --exclude 'src/modules/catalog/catalog.concurrency.test.ts' --exclude 'src/modules/minibar/minibar.integration.test.ts' --exclude 'src/modules/minibar/minibar.authorization.http.test.ts' --exclude 'src/modules/minibar/minibar.concurrency.test.ts' --exclude 'src/modules/stay/stay.integration.test.ts' --exclude 'src/modules/stay/stay.authorization.http.test.ts' --exclude 'src/modules/stay/stay.concurrency.test.ts' --exclude 'src/modules/stay/checkout.integration.test.ts' --exclude 'src/modules/stay/checkout.concurrency.test.ts' --exclude 'src/modules/billing/billing.integration.test.ts' --exclude 'src/modules/billing/billing.concurrency.test.ts' --exclude 'src/modules/finance/finance.integration.test.ts' --exclude 'src/modules/finance/finance.authorization.http.test.ts' --exclude 'src/modules/finance/finance.concurrency.test.ts'",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "openapi": "tsx src/openapi.ts",
    "test:security": "vitest run src/security src/modules/onboarding/onboarding.security.test.ts",
    "test:integration": "vitest run src/health/health.http.test.ts src/modules/iam/iam.integration.test.ts src/modules/iam/iam.repair.test.ts src/modules/iam/iam.remediation2.test.ts src/modules/iam/iam.remediation3.test.ts src/modules/iam/iam.remediation4.test.ts src/modules/onboarding/onboarding.integration.test.ts src/modules/onboarding/subscription.integration.test.ts src/modules/onboarding/onboarding.remediation1.test.ts src/modules/onboarding/subscription.remediation1.test.ts src/modules/onboarding/onboarding.authorization.http.test.ts src/modules/onboarding/contracts/bullmq-provisioning-signal.test.ts src/modules/onboarding/onboarding.remediation2.test.ts src/modules/catalog/catalog.integration.test.ts src/modules/catalog/catalog.dependency.test.ts src/modules/catalog/catalog.authorization.http.test.ts src/modules/minibar/minibar.integration.test.ts src/modules/minibar/minibar.authorization.http.test.ts src/modules/stay/stay.integration.test.ts src/modules/stay/stay.authorization.http.test.ts src/modules/stay/checkout.integration.test.ts src/modules/billing/billing.integration.test.ts src/modules/finance/finance.integration.test.ts src/modules/finance/finance.authorization.http.test.ts",
    "test:concurrency": "vitest run src/modules/iam/iam.concurrency.test.ts src/modules/onboarding/onboarding.concurrency.test.ts src/modules/catalog/catalog.concurrency.test.ts src/modules/minibar/minibar.concurrency.test.ts src/modules/stay/stay.concurrency.test.ts src/modules/stay/checkout.concurrency.test.ts src/modules/billing/billing.concurrency.test.ts src/modules/finance/finance.concurrency.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@prsystem/authz": "workspace:*",
    "@prsystem/config": "workspace:*",
    "@prsystem/contracts": "workspace:*",
    "@prsystem/db": "workspace:*",
    "@prsystem/money": "workspace:*",
    "@prsystem/ports": "workspace:*",
    "@prsystem/telemetry": "workspace:*",
    "@prsystem/time": "workspace:*",
    "bullmq": "5.81.3",
    "fastify": "5.12.1",
    "ioredis": "5.11.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@prsystem/testing": "workspace:*",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
