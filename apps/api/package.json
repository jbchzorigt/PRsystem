{
  "name": "@prsystem/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "openapi": "tsx src/openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@prsystem/config": "workspace:*",
    "@prsystem/contracts": "workspace:*",
    "@prsystem/db": "workspace:*",
    "@prsystem/money": "workspace:*",
    "@prsystem/telemetry": "workspace:*",
    "@prsystem/time": "workspace:*",
    "fastify": "5.11.3",
    "ioredis": "5.11.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
