{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env.example"],
  "globalEnv": ["NODE_ENV", "APP_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:migrations": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "openapi": {
      "dependsOn": ["build"],
      "outputs": ["openapi.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:integration": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "test:concurrency": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "test:regression": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "test:security": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "cache": false,
      "env": ["DATABASE_URL"]
    }
  }
}
