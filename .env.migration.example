# Migration step environment — MIGRATION ONLY.
#
# Copy to .env.migration and adjust. Supplied to `pnpm run migrate` alone, never
# to a long-lived runtime: both the API and the worker refuse to start when they
# find MIGRATION_DATABASE_URL, because it names a principal that can apply DDL.
#
# This file contains LOCAL DEVELOPMENT DEFAULTS ONLY. It must never contain a
# real credential (CLAUDE.md §8).

# The prsystem_migrate_login principal: a member of prsystem_migrate and nothing
# else, never a superuser. There is deliberately no fallback to DATABASE_URL —
# that holds a runtime principal, and a migration applied as one would create
# objects owned by the wrong role.
MIGRATION_DATABASE_URL=postgresql://prsystem_migrate_login:prsystem_local_dev@127.0.0.1:55442/prsystem

# The operator identities allowed to own the database and schema `public`.
#
# Mandatory, with no default: the migration principal never owns the database, so
# any inferred value would either refuse every real deployment or approve every
# owner. A run with this unset stops before any DDL. No project role — group or
# canonical login — is accepted here whatever it says.
PRSYSTEM_APPROVED_OPERATOR_OWNERS=prsystem
